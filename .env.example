# ─── Provider ───────────────────────────────────────────────────────
# "google" (Gemini) | "anthropic" (Claude) | "ollama" (local, free, unlimited)
LOUPE_PROVIDER=google

# NOTE: LOUPE_MODEL applies to whichever provider is active. Leaving a Gemini
# model here and switching to ollama is caught and corrected with a warning, but
# it is cleaner to comment it out than to rely on that.

# ─── Google AI Studio ───────────────────────────────────────────────
GOOGLE_API_KEY=
# The free-tier daily cap is per project AND PER MODEL, so pointing roles at
# different models gives each its own allowance rather than draining one.
# Current models: gemini-3.8-flash, 3.7-flash, 3.6-flash, 3.5-flash,
# 3.5-flash-lite, 3.1-flash-lite. gemini-2.5-* is retired and returns 404.
LOUPE_MODEL=gemini-3.5-flash
LOUPE_VERIFIER_MODEL=gemini-3.6-flash
LOUPE_CHEAP_MODEL=gemini-3.5-flash-lite
# Client-side requests/minute. Check your real limits at
# https://aistudio.google.com/rate-limit — the daily cap is the one that bites.
LOUPE_RPM=10

# ─── Local model (Ollama) ───────────────────────────────────────────
# As the provider:   LOUPE_PROVIDER=ollama
# As a fallback:     set LOUPE_FALLBACK_MODEL below. It engages only when the
#                    daily quota is exhausted, never on a transient rate limit,
#                    and every review that used it says so.
LOUPE_FALLBACK_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
LOUPE_OLLAMA_NUM_CTX=16384

# ─── Review behaviour ───────────────────────────────────────────────
# Run the repo's own linters first and tell the reviewers not to repeat them.
# "auto" runs them for a local diff but never for a pull request, because a
# repo's lint config is code and reviewing a branch should not execute it.
LOUPE_LINT=auto

# Re-verify a finding N times and take the majority, but only when the reviewer's
# confidence and the gate's verdict disagree. 1 disables it. Each extra sample is
# one more model call.
LOUPE_CONSENSUS_SAMPLES=1

# ─── Cost ───────────────────────────────────────────────────────────
# Which reviewers run. Each is one model call, so this is the biggest lever.
# LOUPE_ROLES=security,correctness
# One call carrying every rubric instead of one call per rubric. Four times
# cheaper; gives up the independence four reviewers are supposed to buy.
# LOUPE_FANOUT=combined
# How many findings to verify, as a multiple of how many get reported. Verifying
# beyond this pays to judge findings that ranking discards unseen.
LOUPE_VERIFY_HEADROOM=2

# ─── Anthropic ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Tracing (LangSmith — works with any provider) ──────────────────
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=code-reviewer

# ─── GitHub (PR adapter) ────────────────────────────────────────────
GITHUB_TOKEN=
