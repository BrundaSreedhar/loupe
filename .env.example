# ─── Provider ───────────────────────────────────────────────────────
# Execution mode: cloud (hosted provider), private (your endpoint, no tracing),
# or offline (loopback local model only; no PR API access).
LOUPE_MODE=cloud
# "google" (Gemini) | "anthropic" (Claude) | "local" (Ollama/vLLM/llama.cpp)
LOUPE_PROVIDER=google

# NOTE: LOUPE_MODEL applies to whichever provider is active. Leaving a Gemini
# A model name belonging to the other provider is caught and corrected with a
# warning, but set it correctly rather than relying on that.

# ─── Google AI Studio ───────────────────────────────────────────────
GOOGLE_API_KEY=
# The free-tier daily cap is per project AND PER MODEL, so pointing roles at
# different models gives each its own allowance rather than draining one.
# Current models: gemini-3.8-flash, 3.7-flash, 3.6-flash, 3.5-flash,
# 3.5-flash-lite, 3.1-flash-lite. gemini-2.5-* is retired and returns 404.
LOUPE_MODEL=gemini-3.5-flash
LOUPE_VERIFIER_MODEL=gemini-3.6-flash
LOUPE_CHEAP_MODEL=gemini-3.5-flash-lite
# Client-side requests/minute. Check your real limits at
# https://aistudio.google.com/rate-limit — the daily cap is the one that bites.
LOUPE_RPM=10

# ─── Anthropic ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Local OpenAI-compatible runtime ───────────────────────────────
# Ollama's OpenAI-compatible endpoint. vLLM and llama.cpp work here too.
# Set LOUPE_MODE=offline + LOUPE_PROVIDER=local to guarantee code never leaves
# this machine. A key is optional for loopback runtimes.
LOUPE_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
LOUPE_LOCAL_API_KEY=

# ─── Tracing (LangSmith — works with any provider) ──────────────────
# Off by default. Set LOUPE_TRACING=on only after accepting that trace content
# may leave the machine. Offline mode always disables it.
LOUPE_TRACING=off
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=code-reviewer

# ─── GitHub (PR adapter) ────────────────────────────────────────────
GITHUB_TOKEN=

# ─── Review behaviour ───────────────────────────────────────────────
# Findings quote the source line they rest on, and are dropped when the quote
# is not in the file. Free — "off" is for measurement, not for saving anything.
LOUPE_GROUNDING=on
# Look up the definitions the changed lines call and show them to the reviewers.
# "auto" is local diffs only: a pull request's repo is not on this disk.
LOUPE_INDEX=auto
LOUPE_INDEX_TOKEN_BUDGET=6000
LOUPE_DEF_MAX_LINES=40
# Run the repository's own linters first. "auto" is local diffs only — running a
# repo's tooling executes its config, which is not safe for someone else's branch.
LOUPE_LINT=auto
# What to do with a credential found in a file being sent: redact | block | warn
LOUPE_ON_SECRET=redact
