# ─── Provider ───────────────────────────────────────────────────────
# "google" (Gemini) | "anthropic" (Claude) | "ollama" (local, free, unlimited)
REVIEWER_PROVIDER=google

# NOTE: REVIEWER_MODEL applies to whichever provider is active. Leaving a Gemini
# model here and switching to ollama is caught and corrected with a warning, but
# it is cleaner to comment it out than to rely on that.

# ─── Google AI Studio ───────────────────────────────────────────────
GOOGLE_API_KEY=
REVIEWER_MODEL=gemini-3.5-flash
REVIEWER_CHEAP_MODEL=gemini-3.5-flash-lite
# Client-side requests/minute. Check your real limits at
# https://aistudio.google.com/rate-limit — the daily cap is the one that bites.
REVIEWER_RPM=10

# ─── Local model (Ollama) ───────────────────────────────────────────
# As the provider:   REVIEWER_PROVIDER=ollama
# As a fallback:     set REVIEWER_FALLBACK_MODEL below. It engages only when the
#                    daily quota is exhausted, never on a transient rate limit,
#                    and every review that used it says so.
REVIEWER_FALLBACK_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
REVIEWER_OLLAMA_NUM_CTX=16384

# ─── Anthropic ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Tracing (LangSmith — works with any provider) ──────────────────
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=code-reviewer

# ─── GitHub (PR adapter) ────────────────────────────────────────────
GITHUB_TOKEN=
