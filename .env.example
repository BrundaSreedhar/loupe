# ─── Provider ───────────────────────────────────────────────────────
# "google" (Gemini, free tier available) | "anthropic" (Claude)
REVIEWER_PROVIDER=google

# ─── Google AI Studio ───────────────────────────────────────────────
# Key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Free tier is Flash-only. Check your own limits at:
#   https://aistudio.google.com/rate-limit
REVIEWER_MODEL=gemini-3.5-flash
REVIEWER_CHEAP_MODEL=gemini-3.5-flash-lite
# Client-side requests/minute. Keep at or under your account's RPM.
REVIEWER_RPM=10

# ─── Anthropic (if REVIEWER_PROVIDER=anthropic) ─────────────────────
ANTHROPIC_API_KEY=
# REVIEWER_MODEL=claude-opus-5

# ─── Tracing (LangSmith — works with either provider) ───────────────
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=code-reviewer

# ─── GitHub (PR adapter) ────────────────────────────────────────────
# Needs: contents:read, pull_requests:write
GITHUB_TOKEN=
