# ─── Provider ───────────────────────────────────────────────────────
# "google" (Gemini) | "anthropic" (Claude)
LOUPE_PROVIDER=google

# NOTE: LOUPE_MODEL applies to whichever provider is active. Leaving a Gemini
# A model name belonging to the other provider is caught and corrected with a
# warning, but set it correctly rather than relying on that.

# ─── Google AI Studio ───────────────────────────────────────────────
GOOGLE_API_KEY=
# The free-tier daily cap is per project AND PER MODEL, so pointing roles at
# different models gives each its own allowance rather than draining one.
# Current models: gemini-3.8-flash, 3.7-flash, 3.6-flash, 3.5-flash,
# 3.5-flash-lite, 3.1-flash-lite. gemini-2.5-* is retired and returns 404.
LOUPE_MODEL=gemini-3.5-flash
LOUPE_VERIFIER_MODEL=gemini-3.6-flash
LOUPE_CHEAP_MODEL=gemini-3.5-flash-lite
# Client-side requests/minute. Check your real limits at
# https://aistudio.google.com/rate-limit — the daily cap is the one that bites.
LOUPE_RPM=10

# ─── Anthropic ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Tracing (LangSmith — works with any provider) ──────────────────
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=code-reviewer

# ─── GitHub (PR adapter) ────────────────────────────────────────────
GITHUB_TOKEN=
